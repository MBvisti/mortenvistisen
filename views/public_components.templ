templ PublicPagination(path string, page, totalPages int64) {
	if totalPages > 1 {
		<nav class="mt-10 flex flex-wrap items-center justify-between gap-4 border-t border-[#2f3a37] pt-6" aria-label="Pagination">
			if page > 1 {
				<a class="public-text-link public-label text-[#8df7a4]" href={ templ.SafeURL(publicPageURL(path, page - 1)) }>← Previous</a>
			} else {
				<span></span>
			}
			<span class="public-label text-[#8f8a7d]">Page { strconv.FormatInt(page, 10) } / { strconv.FormatInt(totalPages, 10) }</span>
			if page < totalPages {
				<a class="public-text-link public-label text-[#8df7a4]" href={ templ.SafeURL(publicPageURL(path, page + 1)) }>Next →</a>
			} else {
				<span></span>
			}
		</nav>
	}
}

templ PublicTableOfContents(headings []HeadingInfo) {
	if len(headings) > 0 {
		<aside class="public-toc" aria-label="Table of contents" data-signals="{activeHeading: ''}">
			<p class="public-label text-[#8df7a4]">On this page</p>
			<ol class="mt-5 space-y-3">
				for index, heading := range headings {
					<li>
						<a
							class="public-toc-link"
							href={ templ.SafeURL("#" + heading.ID) }
							data-class:public-toc-link-active={ fmt.Sprintf("$activeHeading === %q", heading.ID) }
						>
							<span aria-hidden="true">{ fmt.Sprintf("%02d", index + 1) } /</span>
							{ heading.Text }
						</a>
					</li>
				}
			</ol>
		</aside>
	}
}
