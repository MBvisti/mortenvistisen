package views

import (
	"database/sql"
	"fmt"
	"mortenvistisen/router/routes"
	"net/url"
	"strconv"
	"strings"
)

type PublicBreadcrumb struct {
	Label string
	URL   string
}

type PublicShowMetadataItem struct {
	Label string
	Value string
}

func publicReadTime(value sql.NullInt32) string {
	if !value.Valid {
		return "Not listed"
	}
	return fmt.Sprintf("%d min read", value.Int32)
}

func publicPageURL(path string, page int64) string {
	if page <= 1 {
		return path
	}
	u := url.URL{Path: path}
	u.RawQuery = url.Values{"page": {strconv.FormatInt(page, 10)}}.Encode()
	return u.String()
}

func publicImageURL(value sql.NullString) (string, bool) {
	imageURL := strings.TrimSpace(value.String)
	return imageURL, value.Valid && imageURL != ""
}

templ PublicBreadcrumbs(items []PublicBreadcrumb) {
	<nav class="public-breadcrumb" aria-label="Breadcrumb">
		<ol class="flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1">
			for index, item := range items {
				if index > 0 {
					<li aria-hidden="true">/</li>
				}
				<li class="min-w-0">
					if index == len(items) - 1 {
						<span class="break-words text-[#e4dfd2]" aria-current="page">{ item.Label }</span>
					} else {
						<a class="public-text-link break-words text-[#8df7a4]" href={ templ.SafeURL(item.URL) }>{ item.Label }</a>
					}
				</li>
			}
		</ol>
	</nav>
}

templ PublicByline() {
	<p class="public-label mt-5 text-[#8f8a7d]">
		By <a class="public-text-link text-[#8df7a4]" href={ routes.AboutPage.URL() } rel="author">Morten Vistisen</a>
	</p>
}

templ PublicShowMetadata(items []PublicShowMetadataItem) {
	<div class="public-show-meta">
		for index, item := range items {
			<div class="public-show-meta-item">
				<p class="public-label text-[#8df7a4]">{ fmt.Sprintf("%02d / %s", index + 1, item.Label) }</p>
				<p class="mt-4 text-sm leading-6 text-[#e4dfd2]">{ item.Value }</p>
			</div>
		}
	</div>
}

