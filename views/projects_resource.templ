package views

import (
	"mortenvistisen/models"
	"mortenvistisen/router/routes"
	"strings"
)

type ProjectIndex struct {
	Items       []models.ProjectEntity
	CurrentPage int64
	TotalPages  int64
}

func (pi ProjectIndex) PageFragment() string {
	return "project-index-page-fragment"
}

templ (pi ProjectIndex) Page() {
	@base(
		SetTitle("Software Projects and Experiments | Morten Vistisen"),
		SetDescription("Explore software products, open-source tools, and practical experiments built by Morten Vistisen, a Danish software engineer and independent maker."),
		SetSlug(publicPageURL(routes.ProjectIndex.URL(), pi.CurrentPage)),
		SetSchema(ProjectIndexSchema(pi.Items)),
	) {
		@templ.Fragment(pi.PageFragment()) {
			<main id="main-content" class="flex-1">
				<div class="public-shell py-8 sm:py-12">
					@PublicBreadcrumbs([]PublicBreadcrumb{
						{Label: "Home", URL: routes.HomePage.URL()},
						{Label: "Projects"},
					})
					<header class="my-10 max-w-5xl sm:my-14">
						<h1 class="public-display text-[#f2ead8]">Products and experiments.</h1>
						<p class="mt-7 max-w-2xl text-lg leading-8 text-[#aaa393]">Practical software, independent products, and ideas tested in public.</p>
					</header>
					if len(pi.Items) == 0 {
						<div class="public-panel">
							<p class="public-label text-[#8df7a4]">Signal pending</p>
							<p class="mt-4 text-[#aaa393]">No published projects are online yet.</p>
						</div>
					} else {
						<div class="grid grid-cols-1 gap-3 md:grid-cols-2">
							for _, project := range pi.Items {
								<a class="public-panel public-panel-link public-text-link flex min-h-72 flex-col justify-between" href={ routes.ProjectShow.URL(project.Slug) }>
									<div>
										<div class="mb-8 flex flex-wrap items-center justify-between gap-3">
											<p class="public-label text-[#8df7a4]">{ publicDate(project.StartedAt) }</p>
											<p class="public-label text-[#8f8a7d]">{ project.Status }</p>
										</div>
										<h2 class="public-card-heading">{ project.Title }</h2>
									</div>
									<p class="mt-8 leading-7 text-[#aaa393]">{ project.Description }</p>
								</a>
							}
						</div>
					}
					@PublicPagination(routes.ProjectIndex.URL(), pi.CurrentPage, pi.TotalPages)
				</div>
			</main>
		}
	}
}

type ProjectShow struct {
	Item     models.ProjectEntity
	Content  templ.Component
	Headings []HeadingInfo
	Related  []models.ProjectEntity
}

func (ps ProjectShow) PageFragment() string {
	return "project-show-page-fragment"
}

func (ps ProjectShow) metaDescription() string {
	if description := strings.TrimSpace(ps.Item.MetaDescription); description != "" {
		return description
	}
	return ps.Item.Description
}

func projectPageTitle(project models.ProjectEntity) string {
	switch project.Slug {
	case "andurel":
		return "Andurel: Productive Go Web Framework | Morten Vistisen"
	case "deploy-crate":
		return "Deploy Crate: Automated App Deployments | Morten Vistisen"
	}
	if project.MetaTitle != "" {
		return project.MetaTitle
	}
	return project.Title
}

func (ps ProjectShow) headOptions() []HeadDataOption {
	title := projectPageTitle(ps.Item)
	opts := []HeadDataOption{
		SetTitle(title),
		SetDescription(ps.metaDescription()),
		SetSlug(routes.ProjectShow.URL(ps.Item.Slug)),
		SetMetaType("website"),
		SetSchema(ProjectShowSchema(ps.Item)),
	}
	if imageURL, ok := publicImageURL(ps.Item.MetaImageLink); ok {
		opts = append(opts, SetImage(imageURL), SetImageAlt(ps.Item.Title+" social image"))
	} else if imageURL, ok := publicImageURL(ps.Item.ImageLink); ok {
		opts = append(opts, SetImage(imageURL), SetImageAlt(ps.Item.Title+" cover image"))
	}
	return opts
}

templ (ps ProjectShow) Page() {
	@base(ps.headOptions()...) {
		@templ.Fragment(ps.PageFragment()) {
			<main id="main-content" class="flex-1">
				<div class="public-shell py-8 sm:py-12">
					@PublicBreadcrumbs([]PublicBreadcrumb{
						{Label: "Home", URL: routes.HomePage.URL()},
						{Label: "Projects", URL: routes.ProjectIndex.URL()},
						{Label: ps.Item.Title},
					})
					<header class="my-8 sm:my-10">
						<h1 class="public-show-title text-[#f2ead8]">{ ps.Item.Title }</h1>
						@PublicByline()
						<p class="mt-7 max-w-2xl text-lg leading-8 text-[#aaa393]">{ ps.Item.Description }</p>
					</header>
					@PublicShowMetadata([]PublicShowMetadataItem{
						{Label: "Started", Value: publicDate(ps.Item.StartedAt)},
						{Label: "Status", Value: ps.Item.Status},
						{Label: "Type", Value: "Project"},
					})
					if imageURL, ok := publicImageURL(ps.Item.ImageLink); ok {
						<img class="mt-10 aspect-video w-full border border-[#2f3a37] object-cover sm:mt-12" src={ imageURL } alt={ ps.Item.Title + " cover image" } width="1600" height="900" decoding="async"/>
					}
					<div class={ "public-article-content mt-10 sm:mt-12", templ.KV("public-article-content-with-toc", len(ps.Headings) > 0) }>
						@PublicTableOfContents(ps.Headings)
						<div class="min-w-0">
							<article class="prose prose-public max-w-none min-w-0 prose-headings:font-heading prose-headings:font-bold prose-headings:uppercase prose-pre:border prose-pre:border-[#2f3a37] prose-img:h-auto prose-img:w-full prose-img:border prose-img:border-[#2f3a37] [&_h2]:scroll-mt-8">
								@ps.Content
							</article>
							if ps.Item.ProjectUrl.Valid {
								<div class="public-panel public-panel-primary mt-12 max-w-3xl">
									<p class="public-label text-[#130f0b]">Visit project</p>
									<a class="mt-5 inline-flex text-lg font-bold uppercase text-[#130f0b] underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#130f0b]" href={ ps.Item.ProjectUrl.String } target="_blank" rel="noopener noreferrer" data-palantir-event={ "project-" + ps.Item.Slug + "-cta-clicked" }>Open { ps.Item.Title } ↗</a>
								</div>
							}
						</div>
					</div>
					if len(ps.Related) > 0 {
						<section class="mt-12 border-t border-[#2f3a37] pt-10" aria-labelledby="related-projects-title">
							<h2 id="related-projects-title" class="public-heading text-[#f2ead8]">Related projects</h2>
							<div class="mt-6 grid grid-cols-1 gap-3 md:grid-cols-3">
								for _, project := range ps.Related {
									<a class="public-panel public-panel-link public-text-link" href={ routes.ProjectShow.URL(project.Slug) }>
										<p class="public-label text-[#8df7a4]">{ project.Status }</p>
										<h3 class="public-card-heading mt-6">{ project.Title }</h3>
									</a>
								}
							</div>
						</section>
					}
				</div>
			</main>
		}
	}
}
