package views

import (
	"mortenvistisen/internal/request"
	"mortenvistisen/router/cookies"
	"mortenvistisen/router/routes"
	"time"
)

templ base(headOpts ...HeadDataOption) {
	<!DOCTYPE html>
	<html lang="en" class="dark">
		@SetupHead(ctx, headOpts...)
		<body id="top" class="public-site min-h-screen">
			<a class="public-skip-link" href="#main-content">Skip to content</a>
			<header>
				<div class="public-shell flex min-h-16 items-center gap-5">
					<a class="shrink-0 text-sm font-bold uppercase tracking-tight text-[#f2ead8]" href={ routes.HomePage.URL() } aria-label="Morten Vistisen home">
						<span class="hidden sm:inline">Morten Vistisen</span>
						<span class="sm:hidden">MV</span>
					</a>
					<nav class="ml-auto min-w-0 overflow-x-auto" aria-label="Primary navigation">
						<ul class="flex w-max items-center gap-1 text-[0.68rem] font-medium uppercase tracking-[0.12em] text-[#aaa393]">
							<li><a class="public-nav-link" href={ routes.PostIndex.URL() }>Writing</a></li>
							<li><a class="public-nav-link" href={ routes.NewsletterIndex.URL() }>Newsletters</a></li>
							<li><a class="public-nav-link" href={ routes.ProjectIndex.URL() }>Projects</a></li>
							<li><a class="public-nav-link" href={ routes.AboutPage.URL() }>About</a></li>
						</ul>
					</nav>
				</div>
			</header>
			{ children... }
			<footer class="mt-3 border-t border-[#2f3a37] bg-[#101414]">
				<div class="public-shell grid grid-cols-1 gap-10 py-10 md:grid-cols-12 md:py-14">
					<div class="md:col-span-6">
						<p class="public-label text-[#8df7a4]">Morten Vistisen / 2026</p>
						<h2 class="public-card-heading mt-6 max-w-xl">Practical software. Clear thinking.</h2>
						<p class="mt-5 max-w-lg leading-7 text-[#aaa393]">Notes on building with Go, distributed systems, and product-minded engineering.</p>
					</div>
					<nav class="md:col-span-3" aria-label="Footer navigation">
						<h3 class="public-label text-[#8f8a7d]">Index</h3>
						<ul class="mt-5 space-y-3 text-sm text-[#aaa393]">
							<li><a class="public-text-link" href={ routes.PostIndex.URL() }>Writing</a></li>
							<li><a class="public-text-link" href={ routes.NewsletterIndex.URL() }>Newsletters</a></li>
							<li><a class="public-text-link" href={ routes.ProjectIndex.URL() }>Projects</a></li>
							<li><a class="public-text-link" href={ routes.AboutPage.URL() }>About</a></li>
						</ul>
					</nav>
					<nav class="md:col-span-3" aria-label="Social links">
						<h3 class="public-label text-[#8f8a7d]">Elsewhere</h3>
						@PublicSocialLinks("mt-5 space-y-3 text-sm text-[#aaa393]")
					</nav>
					<div class="flex flex-col gap-3 border-t border-[#2f3a37] pt-6 text-xs text-[#8f8a7d] md:col-span-12 md:flex-row md:items-center md:justify-between">
						<p>&copy; { time.Now().Format("2006") } Morten Vistisen. All rights reserved.</p>
						<a class="public-text-link uppercase tracking-[0.12em]" href="https://andurel.com" target="_blank" rel="noopener noreferrer">Built with Andurel</a>
					</div>
				</div>
			</footer>
			<div id="flashContainer" class="fixed bottom-4 right-4 z-50 flex max-w-[calc(100%-2rem)] flex-col gap-2">
				for _, flash := range request.ExtractContext[[]cookies.FlashMessage](ctx, request.SessionFlashesKey) {
					<div class="border border-[#52605c] bg-[#101414] px-4 py-3 text-sm text-[#e4dfd2]">
						{ flash.Message }
					</div>
				}
			</div>
		</body>
	</html>
}
