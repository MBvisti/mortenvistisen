package views

import (
	"mortenvistisen/models"
	"mortenvistisen/router/routes"
)

type NewsletterIndex struct {
	Items       []models.NewsletterEntity
	CurrentPage int64
	TotalPages  int64
}

func (ni NewsletterIndex) PageFragment() string {
	return "newsletter-index-page-fragment"
}

templ (ni NewsletterIndex) Page() {
	@base(
		SetTitle("Software Engineering Newsletters | Morten Vistisen"),
		SetDescription("Read Morten Vistisen's field notes and newsletters about software engineering, building useful products, independent work, and lessons from the workshop."),
		SetSlug(publicPageURL(routes.NewsletterIndex.URL(), ni.CurrentPage)),
		SetSchema(NewsletterIndexSchema(ni.Items)),
	) {
		@templ.Fragment(ni.PageFragment()) {
			<main id="main-content" class="flex-1">
				<div class="public-shell py-8 sm:py-12">
					@PublicBreadcrumbs([]PublicBreadcrumb{
						{Label: "Home", URL: routes.HomePage.URL()},
						{Label: "Newsletters"},
					})
					<header class="my-10 max-w-5xl sm:my-14">
						<h1 class="public-display text-[#f2ead8]">Field notes and dispatches.</h1>
						<p class="mt-7 max-w-2xl text-lg leading-8 text-[#aaa393]">Longer observations from the workshop, sent when there is something useful to share.</p>
					</header>
					<section class="public-panel mb-3 grid gap-8 lg:grid-cols-2 lg:items-end" aria-labelledby="newsletter-subscription-title">
						<div>
							<p class="public-label text-[#8df7a4]">Stay in the loop</p>
							<h2 id="newsletter-subscription-title" class="public-card-heading mt-5">Get the next dispatch.</h2>
							<p class="mt-4 max-w-xl leading-7 text-[#aaa393]">Enter your email and confirm it from your inbox. No fixed schedule, only useful updates.</p>
						</div>
						<form class="flex flex-col gap-3 sm:flex-row" action={ routes.SubscriberCreate.URL() } method="post">
							<label class="sr-only" for="newsletter-email">Email address</label>
							<input id="newsletter-email" class="min-h-12 min-w-0 flex-1 border border-[#52605c] bg-[#101414] px-4 text-[#f2ead8] placeholder:text-[#8f8a7d] focus:border-[#8df7a4] focus:outline-none" type="email" name="email" placeholder="you@example.com" autocomplete="email" maxlength="254" required/>
							<button class="min-h-12 border border-[#8df7a4] bg-[#8df7a4] px-6 font-bold uppercase tracking-[0.08em] text-[#130f0b] hover:brightness-95 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#8df7a4]" type="submit" data-palantir-event="newsletter-subscribe-clicked">Subscribe</button>
						</form>
					</section>
					if len(ni.Items) == 0 {
						<div class="public-panel">
							<p class="public-label text-[#8df7a4]">Signal pending</p>
							<p class="mt-4 text-[#aaa393]">No published newsletter issues are online yet.</p>
						</div>
					} else {
						<div class="grid grid-cols-1 gap-3 md:grid-cols-2">
							for _, newsletter := range ni.Items {
								<a class="public-panel public-panel-link public-text-link flex min-h-72 flex-col justify-between" href={ routes.NewsletterShow.URL(newsletter.Slug.String) }>
									<div>
										<p class="public-label mb-8 text-[#8df7a4]">{ publicDate(newsletter.ReleasedAt) }</p>
										<h2 class="public-card-heading">{ newsletter.Title }</h2>
									</div>
									<p class="mt-8 leading-7 text-[#aaa393]">{ newsletter.MetaDescription }</p>
								</a>
							}
						</div>
					}
					@PublicPagination(routes.NewsletterIndex.URL(), ni.CurrentPage, ni.TotalPages)
				</div>
			</main>
		}
	}
}

type NewsletterShow struct {
	Item     models.NewsletterEntity
	Content  templ.Component
	Headings []HeadingInfo
	Related  []models.NewsletterEntity
}

func (ns NewsletterShow) PageFragment() string {
	return "newsletter-show-page-fragment"
}

func (ns NewsletterShow) headOptions() []HeadDataOption {
	title := ns.Item.Title
	if ns.Item.MetaTitle != "" {
		title = ns.Item.MetaTitle
	}
	opts := []HeadDataOption{
		SetTitle(title),
		SetDescription(ns.Item.MetaDescription),
		SetSlug(routes.NewsletterShow.URL(ns.Item.Slug.String)),
		SetMetaType("article"),
		SetSchema(NewsletterShowSchema(ns.Item)),
	}
	if imageURL, ok := publicImageURL(ns.Item.MetaImageLink); ok {
		opts = append(opts, SetImage(imageURL), SetImageAlt(ns.Item.Title+" social image"))
	} else if imageURL, ok := publicImageURL(ns.Item.ImageLink); ok {
		opts = append(opts, SetImage(imageURL), SetImageAlt(ns.Item.Title+" cover image"))
	}
	return opts
}

templ (ns NewsletterShow) Page() {
	@base(ns.headOptions()...) {
		@templ.Fragment(ns.PageFragment()) {
			<main id="main-content" class="flex-1">
				<div class="public-shell py-8 sm:py-12">
					@PublicBreadcrumbs([]PublicBreadcrumb{
						{Label: "Home", URL: routes.HomePage.URL()},
						{Label: "Newsletters", URL: routes.NewsletterIndex.URL()},
						{Label: ns.Item.Title},
					})
					<header class="my-8 sm:my-10">
						<h1 class="public-show-title text-[#f2ead8]">{ ns.Item.Title }</h1>
						@PublicByline()
					</header>
					@PublicShowMetadata([]PublicShowMetadataItem{
						{Label: "Released", Value: publicDate(ns.Item.ReleasedAt)},
						{Label: "Type", Value: "Newsletter"},
						{Label: "Status", Value: "Published"},
					})
					if imageURL, ok := publicImageURL(ns.Item.ImageLink); ok {
						<img class="mt-10 aspect-video w-full border border-[#2f3a37] object-cover sm:mt-12" src={ imageURL } alt={ ns.Item.Title + " cover image" } width="1600" height="900" decoding="async"/>
					}
					<div class={ "public-article-content mt-10 sm:mt-12", templ.KV("public-article-content-with-toc", len(ns.Headings) > 0) }>
						@PublicTableOfContents(ns.Headings)
						<article class="prose prose-public max-w-none min-w-0 prose-headings:font-heading prose-headings:font-bold prose-headings:uppercase prose-pre:border prose-pre:border-[#2f3a37] prose-img:h-auto prose-img:w-full prose-img:border prose-img:border-[#2f3a37] [&_h2]:scroll-mt-8">
							@ns.Content
						</article>
					</div>
					if len(ns.Related) > 0 {
						<section class="mt-12 border-t border-[#2f3a37] pt-10" aria-labelledby="related-newsletters-title">
							<h2 id="related-newsletters-title" class="public-heading text-[#f2ead8]">Related newsletters</h2>
							<div class="mt-6 grid grid-cols-1 gap-3 md:grid-cols-3">
								for _, newsletter := range ns.Related {
									<a class="public-panel public-panel-link public-text-link" href={ routes.NewsletterShow.URL(newsletter.Slug.String) }>
										<p class="public-label text-[#8df7a4]">{ publicDate(newsletter.ReleasedAt) }</p>
										<h3 class="public-card-heading mt-6">{ newsletter.Title }</h3>
									</a>
								}
							</div>
						</section>
					}
				</div>
			</main>
		}
	}
}
